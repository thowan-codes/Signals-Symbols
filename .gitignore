# Unreal Engine generated files and directories
# These names apply at every level, including VotV/ and its plugins.
[Bb]inaries/
[Dd]erivedDataCache/
[Ii]ntermediate/
[Ss]aved/

# Local VotV game assets are needed for editing but must not be redistributed.
# Keep only this project's mod content under the game's Content directory.
/VotV/Content/*
!/VotV/Content/Mods/
/VotV/Content/Mods/*
!/VotV/Content/Mods/Signals_and_Symbols/
!/VotV/Content/Mods/Signals_and_Symbols/**

# Generated IDE project files and local IDE state
.vs/
.idea/
*.sln
*.sln.docstates
*.suo
*.user
*.userosscache
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.xcodeproj
*.xcworkspace

# Compiler and linker by-products that can appear outside Unreal's folders
*.obj
*.o
*.pch
*.gch
*.ipch
*.pdb
*.idb
*.ilk
*.exp
*.iobj
*.ipdb

# OS and editor clutter
.DS_Store
Thumbs.db
*.swp
*~
/Dist
